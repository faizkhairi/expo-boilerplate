# =============================================================================
# expo-boilerplate: environment variables
# =============================================================================
# Copy this file to .env and fill in your values. Variables prefixed with
# EXPO_PUBLIC_ are inlined into the app bundle, so never put secrets here.

# --- API ---------------------------------------------------------------------
# Base URL of your backend. Defaults to http://localhost:3000/api when unset.
# On a physical device, use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL="http://localhost:3000/api"

# --- EAS Build ---------------------------------------------------------------
# No variable needed: `eas init` writes the project ID to app.json
# (expo.extra.eas.projectId).
